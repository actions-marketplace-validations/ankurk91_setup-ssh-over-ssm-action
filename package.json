{
  "name": "setup-ssh-over-ssm-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that configures SSH access to a private EC2 instance through AWS Systems Manager Session Manager.",
  "type": "module",
  "license": "MIT",
  "author": "ankurk91",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint --max-warnings=0",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:e2e": "test/e2e/run.sh",
    "build:main": "ncc build src/main.js -o dist/main",
    "build:post": "ncc build src/post.js -o dist/post",
    "build": "pnpm run build:main && pnpm run build:post",
    "package": "pnpm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@aws-sdk/client-ec2-instance-connect": "^3.1135.0",
    "@aws-sdk/client-ssm": "^3.1135.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "oxlint": "^1.83.0"
  }
}
